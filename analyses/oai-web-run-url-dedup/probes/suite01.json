    "steps": [
      {"kind": "seed", "path": "/{RID}_p12", "value": "P12_V1_{RID}"},
      {"kind": "fetch", "label": "A_first", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p12"},
