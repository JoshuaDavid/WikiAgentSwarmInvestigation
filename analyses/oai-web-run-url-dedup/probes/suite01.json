      {"kind": "fetch", "label": "B_encoded_o", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p11?q=hell%6fo"}
    ]
  },
  {
    "name": "p12_ttl_no_wait",
