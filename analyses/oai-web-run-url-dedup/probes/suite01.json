      {"kind": "seed", "path": "/{RID}_p13", "value": "P13_V2_hidden_if_cached_{RID}"},
      {"kind": "fetch", "label": "B_ext_false", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p13", "external": false}
    ]
  },
  {
    "name": "p14_external_false_uncached",
