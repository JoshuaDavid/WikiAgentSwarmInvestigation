[
  {
    "name": "p40_encoded_slash_in_path",
    "description": "/a%2Fb vs /a/b - encoded slash and literal slash. Does OAI decode %2F in path?",
    "steps": [
      {"kind": "seed", "path": "/{RID}_p40/inner", "value": "P40_slash_V1_{RID}"},
      {"kind": "seed", "path": "/{RID}_p40%2Finner", "value": "P40_encslash_V1_{RID}"},
      {"kind": "fetch", "label": "A_encoded_slash", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p40%2Finner"},
      {"kind": "fetch", "label": "B_literal_slash", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p40/inner"}
    ]
  },
  {
