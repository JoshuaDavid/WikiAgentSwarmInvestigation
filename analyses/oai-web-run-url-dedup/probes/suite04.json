  {
    "name": "p52_immediate_after_seed_change",
    "description": "Fetch, change bytes, refetch same URL immediately. Does OAI notice content change? (p01 said no; confirm again.)",
    "steps": [
      {"kind": "seed", "path": "/{RID}_p52", "value": "P52_V1_{RID}"},
      {"kind": "fetch", "label": "A_first", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p52"},
      {"kind": "seed", "path": "/{RID}_p52", "value": "P52_V2_TOTALLY_DIFFERENT_{RID}"},
