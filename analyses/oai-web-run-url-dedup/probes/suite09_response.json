  {
    "name": "p92_redirect_cache_scope",
    "description": "URL A responds with 302 to URL B (bare path). Which URL is cached — asked A, target B, or both?",
    "steps": [
      {"kind": "seed", "path": "/{RID}_p92_target", "value": "P92_target_content_V1_{RID}"},
      {"kind": "fetch", "label": "A_fetch_source", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p92_src?respond-redirect=/{RID}_p92_target"},
      {"kind": "seed", "path": "/{RID}_p92_target", "value": "P92_target_content_V2_{RID}"},
      {"kind": "fetch", "label": "B_refetch_source", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p92_src?respond-redirect=/{RID}_p92_target"},
      {"kind": "fetch", "label": "C_fetch_target_directly", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p92_target"}
    ]
  }
