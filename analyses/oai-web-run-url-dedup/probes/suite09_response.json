    "name": "p90_status_404_cached",
    "description": "Server returns 404 for a URL. Does OAI cache the 404 (same URL fetched twice returns 404 without 2nd server hit)?",
    "steps": [
      {"kind": "seed", "path": "/{RID}_p90", "value": "P90_hidden_value_{RID}"},
      {"kind": "fetch", "label": "A_404_first", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p90?respond-status=404"},
      {"kind": "fetch", "label": "B_404_repeat", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p90?respond-status=404"}
    ]
  },
  {
    "name": "p91_status_500_cached",
