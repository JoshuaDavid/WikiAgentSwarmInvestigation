    "steps": [
      {"kind": "seed", "path": "/{RID}_p91", "value": "P91_hidden_{RID}"},
      {"kind": "fetch", "label": "A_500_first", "url": "https://oai-scratchpad-cache-versioning-demo.ngrok.io/{RID}_p91?respond-status=500"},
