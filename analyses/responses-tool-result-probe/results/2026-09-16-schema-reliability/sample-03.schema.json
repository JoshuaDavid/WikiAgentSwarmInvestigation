{
  "type": "object",
  "properties": {
    "open": {
      "description": "Open the page indicated by ref_id and position viewport at the line number lineno. In addition to reference ids, you can also use the fully qualified URL. If lineno is not provided, the viewport will be positioned at the beginning of the document or centered on the most relevant passage, if available. You can use this to scroll to a new location of previously opened pages.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "lineno": {
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "ref_id"
        ]
      }
    },
    "click": {
      "description": "Open the link id from the page indicated by ref_id. Valid link ids are displayed with the formatting: 【{id}†.*】.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "ref_id",
          "id"
        ]
      }
    },
    "find": {
      "description": "Find the text pattern in the page indicated by ref_id.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "ref_id",
          "pattern"
        ]
      }
    },
    "screenshot": {
      "description": "Take a screenshot of the page pageno indicated by ref_id. Currently only works on pdfs. pageno is 0-indexed and can be at most the number of pdf pages -1.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "pageno": {
            "type": "integer"
          }
        },
        "required": [
          "ref_id",
          "pageno"
        ]
      }
    },
    "image_query": {
      "description": "Query image search engine for a given list of queries.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "description": "Search query",
            "type": "string"
          },
          "recency": {
            "description": "Whether to filter by recency (response would be within this number of recent days).",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          },
          "domains": {
            "description": "Whether to filter by a specific list of domains.",
            "type": [
              "array",
              "null"
            ],
            "default": null,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "q"
        ]
      }
    },
    "sports": {
      "description": "Look up sports schedules and standings for games in a given league.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "sports"
            ]
          },
          "fn": {
            "type": "string",
            "enum": [
              "schedule",
              "standings"
            ]
          },
          "league": {
            "type": "string",
            "enum": [
              "nba",
              "wnba",
              "nfl",
              "nhl",
              "mlb",
              "epl",
              "ncaamb",
              "ncaawb",
              "ipl"
            ]
          },
          "team": {
            "description": "Search for the team. Use the team's most-common 3/4 letter alias that would be used in TV broadcasts etc.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "opponent": {
            "description": "Use opponent and team to search games between the two teams.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "date_from": {
            "description": "In YYYY-MM-DD format",
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "date_to": {
            "description": "In YYYY-MM-DD format",
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "num_games": {
            "type": [
              "integer",
              "null"
            ],
            "default": 20
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "tool",
          "fn",
          "league"
        ]
      }
    },
    "finance": {
      "description": "Look up prices for a given list of stock symbols.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "equity",
              "fund",
              "crypto",
              "index"
            ]
          },
          "market": {
            "description": "ISO 3166 3-letter Country Code, or OTC for Over-the-Counter markets, or an empty string for Cryptocurrency.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "ticker",
          "type"
        ]
      }
    },
    "weather": {
      "description": "Look up weather for a given list of locations.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "description": "Location in Country, Area, City format",
            "type": "string"
          },
          "start": {
            "description": "Start date in YYYY-MM-DD format. Default is today.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "duration": {
            "description": "Number of days. Default is 7.",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "location"
        ]
      }
    },
    "calculator": {
      "description": "Do basic calculations with a calculator.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          }
        },
        "required": [
          "expression",
          "prefix",
          "suffix"
        ]
      }
    },
    "time": {
      "description": "Get time for the given list of UTC offsets.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "utc_offset": {
            "description": "UTC offset formatted like '+03:00'",
            "type": "string"
          }
        },
        "required": [
          "utc_offset"
        ]
      }
    },
    "response_length": {
      "description": "The length of the response to be returned",
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    },
    "search_query": {
      "description": "Query internet search engine for a given list of queries.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "description": "Search query",
            "type": "string"
          },
          "recency": {
            "description": "Whether to filter by recency (response would be within this number of recent days).",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "default": null
          },
          "domains": {
            "description": "Whether to filter by a specific list of domains.",
            "type": [
              "array",
              "null"
            ],
            "default": null,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "q"
        ]
      }
