      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "description": "Tool",
            "type": "string",
            "enum": [
              "sports"
            ]
          },
          "fn": {
            "description": "Fn",
            "type": "string",
            "enum": [
              "schedule",
              "standings"
            ]
          },
          "league": {
            "description": "League",
            "type": "string",
            "enum": [
              "nba",
              "wnba",
              "nfl",
              "nhl",
              "mlb",
              "epl",
              "ncaamb",
              "ncaawb",
              "ipl"
            ]
          },
          "team": {
            "description": "Search for the team. Use the team's most-common 3/4 letter alias that would be used in TV broadcasts etc.",
