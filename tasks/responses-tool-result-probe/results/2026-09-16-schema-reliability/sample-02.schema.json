{
  "type": "object",
  "properties": {
    "open": {
      "description": "Open the page indicated by ref_id and position viewport at the line number lineno. In addition to reference ids (like \"turn0search1\"), you can also use the fully qualified URL. If lineno is not provided, the viewport will be positioned at the beginning of the document or centered on the most relevant passage, if available. You can use this to scroll to a new location of previously opened pages.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "description": "Ref Id",
            "type": "string"
          },
          "lineno": {
            "description": "Lineno",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "ref_id"
        ]
      }
    },
    "click": {
      "description": "Open the link id from the page indicated by ref_id. Valid link ids are displayed in the page's link formatting.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "description": "Ref Id",
            "type": "string"
          },
          "id": {
            "description": "Id",
            "type": "integer"
          }
        },
        "required": [
          "ref_id",
          "id"
        ]
      }
    },
    "find": {
      "description": "Find the text pattern in the page indicated by ref_id.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "description": "Ref Id",
            "type": "string"
          },
          "pattern": {
            "description": "Pattern",
            "type": "string"
          }
        },
        "required": [
          "ref_id",
          "pattern"
        ]
      }
    },
    "screenshot": {
      "description": "Take a screenshot of the page pageno indicated by ref_id. Currently only works on pdfs. pageno is 0-indexed and can be at most the number of pdf pages -1.",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ref_id": {
            "description": "Ref Id",
            "type": "string"
          },
          "pageno": {
            "description": "Pageno",
            "type": "integer"
          }
        },
        "required": [
          "ref_id",
          "pageno"
        ]
      }
    },
    "image_query": {
      "description": "query image search engine for a given list queries",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "description": "search query",
            "type": "string"
          },
          "recency": {
            "description": "whether to filter by recency (response would be within this number of recent days)",
            "type": [
              "integer",
              "null"
            ],
            "default": null
          },
          "domains": {
            "description": "whether to filter by a specific list of domains",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "default": null
          }
        },
        "required": [
          "q"
        ]
      }
    },
    "sports": {
