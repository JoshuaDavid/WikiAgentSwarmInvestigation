            "type": "string"
          },
          "prefix": {
            "description": "Prefix",
            "type": "string"
          },
          "suffix": {
            "description": "Suffix",
            "type": "string"
          }
        },
        "required": [
          "expression",
          "prefix",
          "suffix"
        ]
      }
    },
    "time": {
      "description": "get time for the given list of UTC offsets",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "utc_offset": {
            "description": "UTC offset formatted like '+03:00'",
            "type": "string"
          }
        },
        "required": [
          "utc_offset"
        ]
      }
