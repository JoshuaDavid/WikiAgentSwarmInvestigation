              "string",
              "null"
            ],
            "default": null
          },
          "opponent": {
            "description": "use \"opponent\" and \"team\" to search games between the two teams",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "date_from": {
            "description": "in YYYY-MM-DD format",
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "date_to": {
            "description": "in YYYY-MM-DD format",
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "num_games": {
            "description": "Num Games",
            "type": [
              "integer",
              "null"
            ],
            "default": 20
          },
          "locale": {
            "description": "Locale",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "tool",
          "fn",
          "league"
        ]
      }
    },
    "finance": {
      "description": "look up prices for a given list of stock symbols",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "ticker": {
            "description": "Ticker",
            "type": "string"
          },
          "type": {
            "description": "Type",
            "type": "string",
            "enum": [
              "equity",
              "fund",
              "crypto",
              "index"
            ]
          },
          "market": {
            "description": "ISO 3166 3-letter Country Code, or \"OTC\" for Over-the-Counter markets, or \"\" for Cryptocurrency",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "ticker",
          "type"
        ]
      }
    },
    "weather": {
      "description": "look up weather for a given list of locations",
      "type": [
        "array",
        "null"
      ],
      "default": null,
      "items": {
        "type": "object",
        "properties": {
          "location": {
